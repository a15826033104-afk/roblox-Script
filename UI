local tRotation = Window:MakeTab({ Name = "旋转", Icon = TAB_ICON })
local RotationConfig = { Enabled = false, Speed = 1, Direction = 1 }
local rotationConnection = nil

local function startRotation()
	if rotationConnection then rotationConnection:Disconnect() rotationConnection = nil end
	if not RotationConfig.Enabled then
		if LPlr.Character then local humanoid = LPlr.Character:FindFirstChildOfClass("Humanoid") if humanoid then humanoid.AutoRotate = true end end
		return
	end
	if LPlr.Character then local humanoid = LPlr.Character:FindFirstChildOfClass("Humanoid") if humanoid then humanoid.AutoRotate = false end end
	rotationConnection = RS.RenderStepped:Connect(function()
		if not RotationConfig.Enabled then return end
		local char = LPlr.Character if not char then return end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end
		if Config.AutoAimBloodMan then
			local bloodMan = cachedBloodMan
			if bloodMan and bloodMan.Parent then
				local targetPart = bloodMan:FindFirstChild("HumanoidRootPart") or bloodMan:FindFirstChild("Head") or bloodMan:FindFirstChildWhichIsA("BasePart")
				if targetPart then
					local origin, destination = hrp.Position + Vector3.new(0, 1, 0), targetPart.Position + Vector3.new(0, 1, 0)
					local direction, distance = (destination - origin).Unit, (destination - origin).Magnitude
					local raycastParams = RaycastParams.new() raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
					local ignoreList = {}
					for _, v in pairs(char:GetDescendants()) do if v:IsA("BasePart") then table.insert(ignoreList, v) end end
					for _, v in pairs(bloodMan:GetDescendants()) do if v:IsA("BasePart") then table.insert(ignoreList, v) end end
					for i = 1, #cachedHumanoidModels do local model = cachedHumanoidModels[i] if model ~= char and model ~= bloodMan then for _, v in pairs(model:GetDescendants()) do if v:IsA("BasePart") then table.insert(ignoreList, v) end end end end
					raycastParams.FilterDescendantsInstances = ignoreList
					local raycastResult = workspace:Raycast(origin, direction * distance, raycastParams)
					if not raycastResult then
						local humanoid = char:FindFirstChildOfClass("Humanoid") if humanoid then humanoid.AutoRotate = false end
						hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(targetPart.Position.X, hrp.Position.Y, targetPart.Position.Z))
						return
					end
				end
			end
		end
		local currentCFrame = hrp.CFrame local rotationAngle = math.rad(RotationConfig.Speed * RotationConfig.Direction) local newCFrame = currentCFrame * CFrame.Angles(0, rotationAngle, 0) hrp.CFrame = newCFrame
	end)
end


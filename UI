local function InteractWithObject(obj)
	local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then fireproximityprompt(prompt) else game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game) game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game) end
end

local function IsValidGroundItem(obj)
	local allPlayers = Players:GetPlayers()
	for i = 1, #allPlayers do local p = allPlayers[i] if p.Character and obj:IsDescendantOf(p.Character) then return false end local bp = p:FindFirstChild("Backpack") if bp and obj:IsDescendantOf(bp) then return false end end
	if obj:IsA("BasePart") then if obj.Transparency > 0.5 or obj.Position.Y < -50 then return false end else if obj:GetPivot().Position.Y < -50 then return false end end
	return true
end

local ItemPriority = { ["Screw"] = 1, ["Pipe"] = 1, ["Bucket"] = 1, ["Baterry"] = 1, ["Gear"] = 1, ["Cleaner"] = 1, ["Emerald"] = 14, ["Diamond"] = 7, ["Gold"] = 2, ["Copper"] = 1, ["Meat"] = 3 }

local function PlayerHasLootToSell()
	local char = LPlr.Character local bp = LPlr:FindFirstChild("Backpack")
	if bp then for _, tool in pairs(bp:GetChildren()) do if tool:IsA("Tool") and ItemPriority[tool.Name] then return true end end end
	if char then for _, tool in pairs(char:GetChildren()) do if tool:IsA("Tool") and ItemPriority[tool.Name] then return true end end end
	return false
end

local function FindBestItem()
	local bestItem, bestPriority = nil, 0
	local scrapsFolder = workspace:FindFirstChild("Scraps")
	if not scrapsFolder then return nil end
	for _, v in pairs(scrapsFolder:GetChildren()) do
		if (v:IsA("BasePart") or v:IsA("Model")) and IsValidGroundItem(v) then
			local priority = ItemPriority[v.Name] or 0
			if priority > bestPriority then bestPriority, bestItem = priority, v end
		end
	end
	return bestItem
end

local _cachedRecycler = nil
local function GetRecycler()
	if _cachedRecycler and _cachedRecycler.Parent then return _cachedRecycler end
	_cachedRecycler = workspace:FindFirstChild("ScrapRecycler", true)
	return _cachedRecycler
end


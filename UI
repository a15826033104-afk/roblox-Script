task.spawn(function()
	while true do
		if Config.AutoGold and LPlr.Character and LPlr.Character:FindFirstChild("HumanoidRootPart") then
			local hrp = LPlr.Character.HumanoidRootPart
			local humanoid = LPlr.Character:FindFirstChildOfClass("Humanoid")

			if humanoid and humanoid.Health > 0 then
				if PlayerHasLootToSell() then
					local recycler = GetRecycler()
					if recycler then
						local pos = (recycler:IsA("BasePart") and recycler.CFrame.Position) or recycler:GetPivot().Position
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.AssemblyAngularVelocity = Vector3.zero
						hrp.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
						task.wait(0.15)
						InteractWithObject(recycler)
						task.wait(0.25)
					else
						task.wait(1)
					end
				else
					local targetItem = FindBestItem()
					if targetItem then
						local pos = (targetItem:IsA("BasePart") and targetItem.CFrame.Position) or targetItem:GetPivot().Position
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.AssemblyAngularVelocity = Vector3.zero
						hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
						task.wait(0.15)
						InteractWithObject(targetItem)
						task.wait(0.15)
					else
						task.wait(0.5)
					end
				end
			end
		end
		task.wait(0.1)
	end
end)

local function ApplyObjectESP(v)
	if not v or not v.Parent then return end
	if TargetMonkeys[v.Name] and v:IsA("Model") then
		if Config.MonkeyESP then CreateOutlineESP(v) end
	elseif TargetEarMonkeys[v.Name] and v:IsA("Model") then
		if Config.EarGameESP then CreateEarGameESP(v) end
	elseif v.Name == "ScrapRecycler" and (v:IsA("BasePart") or v:IsA("Model")) then
		if Config.RecyclerESP then CreateRecyclerESP(v) end
	elseif v.Name == "Card" and v:IsA("MeshPart") then
		if Config.CardESP and IsValidGroundItem(v) then CreateCardESP(v) if not table.find(ActiveCards, v) then table.insert(ActiveCards, v) end end
	elseif v.Name == "SCP-3199" and v:IsA("Model") then
		if Config.SCPHighlight and not v:FindFirstChild("SCP3199_ESP") then
			local h = Instance.new("Highlight", v) h.Name, h.FillColor = "SCP3199_ESP", Color3.new(1, 0, 0)
			local b = Instance.new("BillboardGui", v) b.Name, b.Size, b.Adornee, b.AlwaysOnTop, b.ExtentsOffset = "SCP3199_ESP", UDim2.new(0, 150, 0, 50), v.PrimaryPart or v:FindFirstChild("Head"), true, Vector3.new(0, 3, 0)
			local l = Instance.new("TextLabel", b) l.Size, l.BackgroundTransparency, l.Text, l.TextColor3, l.TextSize = UDim2.new(1, 0, 1, 0), 1, "SCP-3199", Color3.new(1, 0, 0), 14
		end
	end
end


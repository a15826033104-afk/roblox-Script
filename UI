RS.RenderStepped:Connect(function()
	if not Config.PlayerESP then return end
	for _, player in pairs(Players:GetPlayers()) do
		if player == LPlr or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
			if ESPObjects[player] then ESPObjects[player].Line.Visible = false ESPObjects[player].Text.Visible = false end
			continue
		end
		if not ESPObjects[player] then ESPObjects[player] = CreateESP(player) end
		local obj, hrp = ESPObjects[player], player.Character.HumanoidRootPart
		local screenPos, onScreen = Cam:WorldToViewportPoint(hrp.Position)
		local teamColor = (player.Team and player.TeamColor.Color) or Color3.fromRGB(0, 255, 0)
		if Config.PlayerHighlight then
			if not player.Character:FindFirstChild("PlayerHighlight") then
				local hl = Instance.new("Highlight")
				hl.Name, hl.FillColor, hl.OutlineColor, hl.Parent = "PlayerHighlight", (player.Team and player.TeamColor.Color) or Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 255), player.Character
				local function onTeamChanged() if hl and hl.Parent then hl.FillColor = (player.Team and player.TeamColor.Color) or Color3.fromRGB(0, 255, 0) end end
				player:GetPropertyChangedSignal("Team"):Connect(onTeamChanged)
			end
		else
			if player.Character:FindFirstChild("PlayerHighlight") then player.Character.PlayerHighlight:Destroy() end
		end
		if onScreen then
			if Config.ShowTracers then obj.Line.From, obj.Line.To, obj.Line.Color, obj.Line.Visible = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y), Vector2.new(screenPos.X, screenPos.Y), teamColor, true else obj.Line.Visible = false end
			if Config.ShowNames then
				local head = player.Character:FindFirstChild("Head")
				local textTarget = head and (head.Position + Vector3.new(0, 0.8, 0)) or (hrp.Position + Vector3.new(0, 3, 0))
				local textPos, textOnScreen = Cam:WorldToViewportPoint(textTarget)
				if textOnScreen then obj.Text.Position = Vector2.new(textPos.X, textPos.Y) else obj.Text.Position = Vector2.new(screenPos.X, screenPos.Y - 20) end
				obj.Text.Text, obj.Text.Color, obj.Text.Visible = player.DisplayName, teamColor, true
			else obj.Text.Visible = false end
		else obj.Line.Visible, obj.Text.Visible = false, false end
	end
end)

